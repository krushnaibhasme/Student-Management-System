# Root .gitignore for Student Information Management System

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Production build outputs
frontend/dist/
frontend/dist-ssr/

# Environment and sensitive keys
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.production

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System & IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
