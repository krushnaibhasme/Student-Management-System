# Backend Server Port
PORT=5000

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/student_db?retryWrites=true&w=majority&appName=Cluster0

# Allowed Frontend URL for CORS
# In development: http://localhost:5173
# In production: Your deployed Vercel URL (e.g. https://student-management-frontend.vercel.app)
FRONTEND_URL=http://localhost:5173

# Application Environment (development | production)
NODE_ENV=development
